# ========================================
# DATABASE CONFIGURATION (Neon + Prisma)
# ========================================
# Get your connection strings from: https://console.neon.tech
# Documentation: docs/template/guides/database-setup.md
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
#
# 2. Create a Neon project at https://neon.tech
#
# 3. Get your connection strings from Neon dashboard:
#    - Pooled connection (with -pooler suffix) → DATABASE_URL
#    - Direct connection (without -pooler) → DIRECT_URL
#
# 4. Replace the placeholders below with your actual credentials

# Pooled connection (for application queries - recommended for serverless)
# Format: postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct connection (for migrations - without -pooler suffix)
# Format: postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/DATABASE?sslmode=require
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ========================================
# NEXT STEPS AFTER CONFIGURATION:
# ========================================
# 1. Generate Prisma Client:
#    npm run db:generate
#
# 2. Push schema to database:
#    npm run db:push
#
# 3. (Optional) Seed database with example data:
#    npm run db:seed
#
# 4. (Optional) Open Prisma Studio to view data:
#    npm run db:studio

# ========================================
# OPTIONAL: MCP SERVERS (Development Tools)
# ========================================
# These variables are for Claude Code MCP servers (optional).
# They are NOT used by the Next.js app directly.
#
# IMPORTANT: MCP servers read from your shell environment, not from .env.local
# To use: Export to your shell profile (~/.bashrc or ~/.zshrc)
# Example: export NEON_API_KEY="your-key-here"
# Then reload: source ~/.bashrc

# Neon MCP Server (optional - for database management with Claude Code)
# Get from: https://console.neon.tech/app/settings/api-keys
# Docs: https://github.com/neondatabase/mcp-server-neon
# NEON_API_KEY=""

# ========================================
# AUTHENTICATION (Better Auth)
# ========================================
# URL base de la aplicacion (requerido para auth client)
# Desarrollo: http://localhost:3000
# Produccion: https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ========================================
# VERCEL CRON JOBS (Production only)
# ========================================
# Secret key para autenticar cron jobs ejecutados por Vercel
# Genera un string aleatorio seguro (ej: openssl rand -base64 32)
# Configurar en: Vercel Dashboard → Settings → Environment Variables
# Docs: https://vercel.com/docs/cron-jobs/manage-cron-jobs
#
# IMPORTANTE:
# - Solo necesario en producción (Vercel)
# - Vercel agrega automáticamente el header: Authorization: Bearer <CRON_SECRET>
# - Los endpoints de cron (/api/cron/*) validan este header
# CRON_SECRET=""
