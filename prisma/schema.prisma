generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Customer {
  id                 String              @id @default(uuid())
  name               String
  phone              String
  email              String?
  creditBalance      Decimal             @default(0) @db.Decimal(12, 2)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  payments           Payment[]
  projects           Project[]
  creditTransactions CreditTransaction[]

  @@index([name])
  @@index([email])
}

model BadgeColor {
  id               String           @id @default(uuid())
  name             String           @unique
  key              String           @unique
  bgClass          String
  textClass        String           @default("text-white")
  order            Int              @default(0)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  projectStatuses  ProjectStatus[]
  uninstallTags    UninstallTag[]
  aftersaleStatuses AftersaleStatus[]
  visitStatuses    VisitStatus[]
  teamTags         TeamTag[]

  @@index([order])
  @@index([isActive])
}

// TeamTag: Integrantes del equipo para asignar a eventos de calendario
model TeamTag {
  id           String     @id @default(uuid())
  name         String     @unique  // Nombre completo del integrante
  abbreviation String              // Iniciales (ej: "JP" para Juan Pérez)
  colorId      String
  order        Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  color        BadgeColor @relation(fields: [colorId], references: [id], onDelete: Restrict)

  // Relaciones M:N con eventos (Prisma crea tablas pivot automáticamente)
  projectEvents   ProjectEvent[]
  aftersaleEvents AftersaleEvent[]
  visitEvents     VisitEvent[]

  @@index([colorId])
  @@index([order])
  @@index([isActive])
  @@map("team_tags")
}

model ProjectStatus {
  id        String     @id @default(uuid())
  name      String     @unique
  order     Int        @default(0)
  colorId   String
  isInitial Boolean    @default(false)
  isFinal   Boolean    @default(false)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  projects  Project[]
  color     BadgeColor @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@index([colorId])
  @@index([order])
  @@index([isActive])
}

model Project {
  id                  String              @id @default(uuid())
  projectNumber       String
  projectName         String?
  customerId          String
  phone               String
  street              String
  apartment           String?
  comuna              String
  region              String
  projectStatusId     String?
  projectStatusLegacy String              @default("") @map("projectStatus")
  date                DateTime            @default(now())
  subtotal            Decimal             @db.Decimal(12, 2)
  taxRate             Decimal             @default(19.0) @db.Decimal(5, 2)
  total               Decimal             @db.Decimal(12, 2)
  balance             Decimal             @default(0) @db.Decimal(12, 2) // Saldo pendiente (total - totalPaid) - calculado
  windowsCount        Int                 @default(0)
  squareMeters        Decimal             @default(0) @db.Decimal(10, 2)
  description         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  currency            String              @default("CLP")
  totalAmount         Decimal?            @db.Decimal(12, 2)
  uninstallTags       ProjectUninstallTag[]
  paymentAllocations  PaymentAllocation[]
  aftersales          Aftersale[]
  calendarEvents      ProjectEvent[]
  creditTransactions  CreditTransaction[]
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projectStatus       ProjectStatus?      @relation(fields: [projectStatusId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([projectNumber])
  @@index([projectStatusId])
  @@index([date])
  @@index([balance]) // Index para filtros eficientes por balance
  @@index([customerId, projectStatusId])
  @@index([projectStatusId, createdAt(sort: Desc)])
  @@index([projectStatusId, balance]) // Index compuesto para filtros de estado + balance
}

model PaymentMethod {
  id              String    @id @default(uuid())
  name            String    @unique
  active          Boolean   @default(true)
  order           Int       @default(0)
  icon            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  hasInstallments Boolean   @default(false)
  maxInstallments Int?
  payments        Payment[]

  @@index([active, order])
}

model Payment {
  id                   String              @id @default(uuid())
  amount               Decimal             @db.Decimal(12, 2)
  currency             String
  date                 DateTime
  reference            String?
  notes                String?
  customerId           String
  paymentMethodId      String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  selectedInstallments Int?
  type                 String              @default("Project")
  installments         Installment[]
  customer             Customer            @relation(fields: [customerId], references: [id])
  paymentMethod        PaymentMethod       @relation(fields: [paymentMethodId], references: [id])
  allocations          PaymentAllocation[]
  creditTransactions   CreditTransaction[]

  @@index([customerId])
  @@index([paymentMethodId])
  @@index([date])
  @@index([type])
  @@index([type, date(sort: Desc)])
}

model Installment {
  id                String    @id @default(uuid())
  paymentId         String
  installmentNumber Int
  amount            Decimal   @db.Decimal(12, 2)
  dueDate           DateTime
  paidDate          DateTime?
  status            String    @default("pending")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  payment           Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status, dueDate])
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  paymentId       String
  projectId       String
  allocatedAmount Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  project         Project  @relation(fields: [projectId], references: [id])

  @@unique([paymentId, projectId])
  @@index([paymentId])
  @@index([projectId])
}

model UninstallTag {
  id           String     @id @default(uuid())
  name         String     @unique
  abbreviation String
  colorId      String
  order        Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  color        BadgeColor @relation(fields: [colorId], references: [id], onDelete: Restrict)
  projects     ProjectUninstallTag[]

  @@index([colorId])
  @@index([order])
  @@index([isActive])
}

// Tabla pivot para relación M:M entre Project y UninstallTag
model ProjectUninstallTag {
  id             String       @id @default(uuid())
  projectId      String
  uninstallTagId String
  createdAt      DateTime     @default(now())

  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uninstallTag   UninstallTag @relation(fields: [uninstallTagId], references: [id], onDelete: Cascade)

  @@unique([projectId, uninstallTagId])
  @@index([projectId])
  @@index([uninstallTagId])
  @@map("project_uninstall_tags")
}

model AftersaleStatus {
  id         String      @id @default(uuid())
  name       String      @unique
  order      Int         @default(0)
  colorId    String
  isInitial  Boolean     @default(false)
  isFinal    Boolean     @default(false)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  aftersales Aftersale[]
  color      BadgeColor  @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@index([colorId])
  @@index([order])
  @@index([isActive])
}

model Aftersale {
  id                String            @id @default(uuid())
  projectId         String
  aftersaleStatusId String
  contactPhone      String            @default("")
  description       String
  reportedAt        DateTime
  tasks             Json              @default("[]") // Lista de tareas para resolver el caso
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  project           Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  aftersaleStatus   AftersaleStatus   @relation(fields: [aftersaleStatusId], references: [id], onDelete: Restrict)
  calendarEvents    AftersaleEvent[]

  @@index([projectId])
  @@index([aftersaleStatusId])
  @@index([reportedAt])
}

model VisitStatus {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int      @default(0)
  colorId   String
  isInitial Boolean  @default(false)
  isFinal   Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visits    Visit[]
  color     BadgeColor @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@index([colorId])
  @@index([order])
  @@index([isActive])
}

model Visit {
  id            String        @id @default(uuid())
  name          String        // Nombre del prospecto
  phone         String?       // Teléfono de contacto

  // Dirección (igual que Project)
  street        String        // Calle
  apartment     String?       // Depto/Oficina (opcional)
  comuna        String        // Comuna
  region        String        // Región

  // Estado configurable
  visitStatusId String
  visitStatus   VisitStatus   @relation(fields: [visitStatusId], references: [id], onDelete: Restrict)

  // Fecha de solicitud
  date          DateTime

  // Observaciones
  observations  String?       @db.Text

  // Metadata
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relaciones
  calendarEvents VisitEvent[]

  @@index([visitStatusId])
  @@index([date])
  @@index([comuna])
  @@index([name])
  @@map("visits")
}

// Eventos de calendario para proyectos
model ProjectEvent {
  id            String   @id @default(uuid())
  projectId     String
  scheduledDate DateTime @db.Date
  order         Int      @default(0) // Orden dentro del día para drag & drop
  tasks         Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamTags      TeamTag[] // Integrantes asignados al evento

  @@unique([projectId, scheduledDate])
  @@index([projectId])
  @@index([scheduledDate])
  @@index([scheduledDate, order]) // Índice para ordenar eventos por día
  @@map("project_events")
}

// Eventos de calendario para postventas
model AftersaleEvent {
  id            String    @id @default(uuid())
  aftersaleId   String
  scheduledDate DateTime  @db.Date
  order         Int       @default(0) // Orden dentro del día para drag & drop
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  aftersale     Aftersale @relation(fields: [aftersaleId], references: [id], onDelete: Cascade)
  teamTags      TeamTag[] // Integrantes asignados al evento

  @@unique([aftersaleId, scheduledDate])
  @@index([aftersaleId])
  @@index([scheduledDate])
  @@index([scheduledDate, order]) // Índice para ordenar eventos por día
  @@map("aftersale_events")
}

// Eventos de calendario para visitas
model VisitEvent {
  id            String   @id @default(uuid())
  visitId       String
  scheduledDate DateTime @db.Date
  order         Int      @default(0) // Orden dentro del día para drag & drop
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  visit         Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  teamTags      TeamTag[] // Integrantes asignados al evento

  @@unique([visitId, scheduledDate])
  @@index([visitId])
  @@index([scheduledDate])
  @@index([scheduledDate, order]) // Índice para ordenar eventos por día
  @@map("visit_events")
}

// Sistema de Créditos por Sobrepago
model CreditTransaction {
  id          String                 @id @default(uuid())
  customerId  String
  customer    Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Monto: positivo = incremento, negativo = decremento
  amount      Decimal                @db.Decimal(12, 2)

  type        CreditTransactionType
  description String?                @db.Text

  // Referencias opcionales para trazabilidad
  projectId   String?
  project     Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)

  paymentId   String?
  payment     Payment?               @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  // Metadata adicional (método de devolución, fecha de devolución, etc.)
  metadata    Json?

  createdAt   DateTime               @default(now())

  @@index([customerId, createdAt(sort: Desc)])
  @@index([type])
  @@index([projectId])
  @@index([paymentId])
  @@map("credit_transactions")
}

enum CreditTransactionType {
  OVERPAYMENT // Sobrepago generado en proyecto
  APPLIED     // Crédito aplicado a pago de proyecto
  REFUND      // Devolución recibida del negocio
  WITHDRAWAL  // Retiro solicitado por cliente
  ADJUSTMENT  // Ajuste manual (admin)
}
