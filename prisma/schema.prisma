generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // Pooled connection for queries
  directUrl = env("DIRECT_URL")         // Direct connection for migrations
}

// ========================================
// BASE SCHEMA - Customize for your project
// ========================================
// This is a starting point. Modify according to your needs.
// See documentation: docs/template/guides/database-setup.md

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Add your relations here
  // Example:
  // posts     Post[]

  @@index([email])
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   // Teléfono obligatorio
  email     String?  // Email opcional
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projects  Project[]

  @@index([name])
  @@index([email])
}

model BadgeColor {
  id          String   @id @default(uuid())
  name        String   @unique       // "Azul", "Verde", "Rojo"
  key         String   @unique       // "blue", "green", "red" (para código)
  bgClass     String                 // "bg-blue-500"
  textClass   String   @default("text-white")  // "text-white"
  order       Int      @default(0)   // Para ordenar en UI
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations - todas las entidades que usen badges
  projectStatuses  ProjectStatus[]

  @@index([order])
  @@index([isActive])
}

model ProjectStatus {
  id        String   @id @default(uuid())
  name      String   @unique
  order     Int      @default(0)

  // FK a BadgeColor
  colorId   String
  color     BadgeColor @relation(fields: [colorId], references: [id], onDelete: Restrict)

  isInitial Boolean  @default(false)
  isFinal   Boolean  @default(false)
  isActive  Boolean  @default(true)

  projects  Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([colorId])
  @@index([order])
  @@index([isActive])
}

model Project {
  id             String   @id @default(uuid())
  projectNumber  String
  projectName    String?  // Glosa

  // Relación con Customer (uno a muchos)
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  phone          String   // Teléfono obligatorio (autocompletado desde customer pero editable)

  // NUEVO: FK a ProjectStatus
  projectStatusId String?
  projectStatus   ProjectStatus? @relation(fields: [projectStatusId], references: [id], onDelete: Restrict)

  // LEGACY: Campo antiguo para migración (temporal)
  projectStatusLegacy String @default("") @map("projectStatus")

  date           DateTime @default(now()) // Fecha de ingreso

  // Financials
  subtotal       Decimal  @db.Decimal(12, 2)
  taxRate        Decimal  @default(19.0) @db.Decimal(5, 2) // Impuesto (%)
  total          Decimal  @db.Decimal(12, 2) // Total calculado = subtotal + (subtotal * taxRate / 100)

  // Metrics
  windowsCount   Int      @default(0) // Elementos
  squareMeters   Decimal  @default(0) @db.Decimal(10, 2) // m²
  description    String?  @db.Text // Descripción

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customerId])
  @@index([projectNumber])
  @@index([projectStatusId])
  @@index([date])
}

